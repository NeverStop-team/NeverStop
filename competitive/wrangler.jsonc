{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "neverstop-competitive-portal",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-27",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "neverstop-competitive",
      "database_id": "REPLACE_WITH_YOUR_D1_ID"
    }
  ],
  "vars": {
    "DISCORD_CLIENT_ID": "",
    "DISCORD_GUILD_ID": "",
    "COMPETITIVE_ROLE_ID": "",
    "ADMIN_USER_IDS": "",
    "PUBLIC_DISCORD_INVITE": "https://discord.gg/ppSVvAr8Bt"
  }
}